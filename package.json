{
  "name": "jie-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check --minimumFailingSeverity warning && astro build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity warning",
    "brand": "node scripts/brand-assets.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "certificates": "node scripts/check-certificates.mjs",
    "links": "linkinator ./dist --recurse --verbosity error --skip \"https://jyotibainstruments.github.io\" --skip \"https://www.google.com/maps\"",
    "lighthouse": "lhci autorun",
    "audit": "npm run contrast && npm run certificates && npm run build && npm run links && npm run lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.16.0",
    "linkinator": "^8.1.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  }
}
