---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['faq', className]}>
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <span>{item.question}</span>
          <svg
            class="faq__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="faq__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .faq__item[open] {
    border-color: color-mix(in srgb, var(--crimson) 45%, var(--line));
  }

  summary {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--crimson);
    transition: transform var(--dur-base) var(--ease);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }

  .faq__answer {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--ink-2);
  }

  .faq__answer p {
    max-width: 68ch;
    margin: 0;
  }
</style>
