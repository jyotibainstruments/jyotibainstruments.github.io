---
import logoUrl from '../assets/brand/jie-logo.svg?url';

interface Props {
  height?: number;
  tone?: 'brand' | 'white';
  decorative?: boolean;
  class?: string;
}

const { height = 44, tone = 'brand', decorative = false, class: className } = Astro.props;
const width = Math.round((height * 845) / 840);
---

<img
  src={logoUrl}
  width={width}
  height={height}
  alt={decorative ? '' : 'Jyotiba Instruments Enterprises'}
  class:list={['logo', tone === 'white' && 'logo--white', className]}
  style={`height: ${height}px; width: auto;`}
  loading="eager"
  decoding="async"
/>

<style>
  .logo {
    max-width: none;
  }

  .logo--white {
    filter: brightness(0) invert(1);
  }
</style>
