---
import type { Certificate } from '../lib/content';

interface Props {
  certificate: Certificate;
}

const { certificate } = Astro.props;

function formatDate(value: string | null): string | null {
  if (!value) return null;
  const date = new Date(`${value}T00:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}

const issued = formatDate(certificate.issued);
const validUntil = formatDate(certificate.validUntil);
const lastAmended = formatDate(certificate.lastAmended);
const validity = [
  issued ? `Issued ${issued}` : null,
  validUntil ? `Valid until ${validUntil}` : null,
  lastAmended ? `Last amended ${lastAmended}` : null,
]
  .filter(Boolean)
  .join(' · ');
---

<article class="cert-card" id={certificate.id}>
  <div class="cert-card__body">
    <p class="cert-card__issuer">{certificate.issuer}</p>
    <h3 class="cert-card__title">{certificate.title}</h3>
    {validity && <p class="cert-card__meta">{validity}</p>}
    {certificate.eventDates && <p class="cert-card__meta">{certificate.eventDates}{certificate.venue ? ` · ${certificate.venue}` : ''}</p>}
    {certificate.territory && <p class="cert-card__meta">Territory: {certificate.territory}</p>}
    {certificate.productLines.length > 0 && (
      <p class="cert-card__meta">Product lines: {certificate.productLines.join(', ')}</p>
    )}
    <p class="cert-card__summary">{certificate.summary}</p>
    {certificate.quote && <blockquote class="cert-card__quote">“{certificate.quote}”</blockquote>}
    {certificate.signatory && <p class="cert-card__meta">Signed: {certificate.signatory}</p>}
  </div>

  {certificate.embedUrl && (
    <div class="cert-card__embed">
      <iframe
        src={certificate.embedUrl}
        title={certificate.alt}
        loading="lazy"
        allow="autoplay"
      ></iframe>
    </div>
  )}
</article>

<style>
  .cert-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .cert-card__body {
    display: grid;
    gap: var(--space-2);
  }

  .cert-card__issuer,
  .cert-card__meta,
  .cert-card__summary,
  .cert-card__title,
  .cert-card__quote {
    margin: 0;
  }

  .cert-card__issuer {
    color: var(--crimson);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cert-card__title {
    font-size: var(--text-xl);
  }

  .cert-card__meta,
  .cert-card__summary {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .cert-card__quote {
    padding-left: var(--space-3);
    border-left: 3px solid var(--crimson);
    color: var(--ink);
    font-size: var(--text-sm);
  }

  .cert-card__embed {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg);
  }

  .cert-card__embed iframe {
    display: block;
    width: 100%;
    height: min(80vh, 720px);
    border: 0;
    background: #fff;
  }
</style>
