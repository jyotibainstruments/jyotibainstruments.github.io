---
import Icon from './icons/Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../config/site';
import { asset } from '../lib/url';

interface Props {
  slug: string;
  name: string;
  pdf: string | null;
  poster?: string | null;
  categories?: Array<{ name: string; page: number }>;
}

const { slug, name, pdf, poster = null, categories = [] } = Astro.props;

/* The self-hosted PDF.js viewer. The facade renders first; nothing from
   PDF.js is downloaded until "Open catalogue" is tapped. */
const viewerUrl = asset('/pdfjs/web/viewer.html');
const pdfUrl = pdf ? asset(pdf) : null;

/* Product enquiry per the site rules: "Hello JIE, I am interested in {product}…" */
const fallbackMessage = `Hello JIE, I am interested in ${name} instruments. Please provide specifications and pricing.`;
---

{
  !pdf || !pdfUrl ? (
    <div class="catalogue catalogue--enquiry">
      <h2 class="catalogue__enquiry-title">{name} instruments and spares</h2>
      <p class="catalogue__enquiry-note">
        Ask about {name} instruments and spares on WhatsApp for specifications and pricing. JIE also
        calibrates, repairs and services all major brands of measuring instruments.
      </p>
      <WhatsAppButton
        placement={`catalogue-${slug}-enquiry`}
        label={`Enquire about ${name} instruments on WhatsApp`}
        message={fallbackMessage}
      />
    </div>
  ) : (
    <div
      class="catalogue"
      data-cat
      data-cat-name={name}
      data-cat-viewer={viewerUrl}
      data-cat-pdf={pdfUrl}
      data-cat-fallback={fallbackMessage}
    >
      {categories.length > 0 && (
        <ul class="catalogue__chips" data-cat-chips aria-label="Open the catalogue at a category">
          {categories.map((category) => (
            <li>
              <button type="button" data-cat-page={category.page}>
                {category.name}
              </button>
            </li>
          ))}
        </ul>
      )}

      <div class="catalogue__card" data-cat-facade>
        <div class="catalogue__poster">
          {poster ? (
            <img src={asset(poster)} alt={`${name} catalogue first page`} width="640" height="853" loading="lazy" />
          ) : (
            <div class="catalogue__cover" aria-hidden="true">
              <span class="catalogue__cover-mark">
                <Icon name="gauge" size={30} />
              </span>
              <span class="catalogue__cover-name">{name}</span>
              <span class="catalogue__cover-rule"></span>
              <span class="catalogue__cover-sub">Calibration · Repairs · Sales</span>
            </div>
          )}
        </div>

        <div class="catalogue__body">
          <div class="catalogue__actions">
            <button class="btn btn--primary" type="button" data-cat-open data-catalogue-open={slug}>
              Open catalogue
            </button>
          </div>

          <ul class="catalogue__links">
            <li>
              <a href={pdfUrl} target="_blank" rel="noopener" data-catalogue-pdf-open={slug}>
                Open PDF in a new tab
              </a>
            </li>
            <li>
              <a href={pdfUrl} data-catalogue-pdf-download={slug} download>
                Download PDF
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="catalogue__viewer" data-cat-panel hidden>
        <div class="catalogue__bar">
          <p class="catalogue__title" data-cat-title>
            {name} catalogue
          </p>
          <div class="catalogue__bar-actions">
            <button type="button" data-cat-full class="catalogue__barbtn">
              Fullscreen
            </button>
            <button type="button" data-cat-close class="catalogue__barbtn catalogue__barbtn--emphasis">
              Close catalogue
            </button>
          </div>
        </div>
        <div class="catalogue__frame" data-cat-frame role="region" aria-label="Catalogue viewer"></div>
      </div>

      <div class="catalogue__enquiry" data-cat-form data-cat-wa-basis={`https://wa.me/${site.whatsapp}`}>
        <label class="catalogue__label" for={`cat-product-${slug}`}>
          Product name or code
        </label>
        <input
          class="catalogue__input"
          id={`cat-product-${slug}`}
          name="product"
          type="text"
          autocomplete="off"
          maxlength={80}
          placeholder="e.g. instrument name or code"
        />
        <button class="btn btn--primary catalogue__send" type="button" data-cat-send data-wa={`catalogue-${slug}-enquiry`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <!-- WhatsApp glyph from Simple Icons (CC0). -->
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488" />
          </svg>
          Enquire on WhatsApp
        </button>
      </div>
    </div>
  )
}

<style>
  .catalogue {
    display: grid;
    gap: var(--space-5);
  }

  .catalogue--enquiry {
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .catalogue__enquiry-title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .catalogue__enquiry-note {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .catalogue__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalogue__chips button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--crimson-900);
    font-size: var(--text-xs);
    font-weight: 650;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease);
  }

  .catalogue__chips button:hover {
    border-color: var(--crimson);
    background: var(--crimson);
    color: var(--on-crimson);
  }

  .catalogue__card {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    padding: clamp(20px, 4vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 640px) {
    .catalogue__card {
      grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
    }
  }

  .catalogue__poster {
    width: 100%;
  }

  .catalogue__poster img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--crimson-50);
  }

  /* Neutral cover used until the owner supplies a first-page poster. */
  .catalogue__cover {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--space-2);
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: var(--space-5);
    border: 1px solid var(--crimson-900);
    border-radius: var(--radius-card);
    background:
      radial-gradient(
        circle at 82% 12%,
        color-mix(in srgb, var(--on-crimson) 14%, transparent),
        transparent 42%
      ),
      linear-gradient(160deg, var(--crimson), var(--crimson-900));
    color: var(--on-crimson);
  }

  .catalogue__cover-mark {
    display: inline-grid;
    width: 48px;
    height: 48px;
    margin-bottom: auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--on-crimson) 22%, transparent);
    border-radius: var(--radius-pill);
    color: var(--on-crimson);
  }

  .catalogue__cover-name {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .catalogue__cover-rule {
    width: 48px;
    height: 4px;
    margin-block: var(--space-1);
    border-radius: 2px;
    background: color-mix(in srgb, var(--on-crimson) 55%, transparent);
  }

  .catalogue__cover-sub {
    color: color-mix(in srgb, var(--on-crimson) 82%, transparent);
    font-size: var(--text-xs);
    font-weight: 550;
    letter-spacing: 0.04em;
  }

  .catalogue__body {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .catalogue__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .catalogue__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalogue__links li + li {
    margin-top: var(--space-2);
  }

  .catalogue__links a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--crimson);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .catalogue__links a:hover {
    color: var(--crimson-900);
  }

  /* Open viewer */

  .catalogue__viewer {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .catalogue__bar {
    --focus-keyline: var(--on-crimson);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--crimson-900);
    color: var(--on-crimson);
  }

  .catalogue__title {
    margin: 0;
    flex: 1 1 auto;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .catalogue__bar-actions {
    display: flex;
    gap: var(--space-2);
  }

  .catalogue__barbtn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--on-crimson) 65%, transparent);
    border-radius: 12px;
    background: transparent;
    color: var(--on-crimson);
    font-size: var(--text-xs);
    font-weight: 650;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .catalogue__barbtn:hover {
    background: var(--surface);
    border-color: var(--surface);
    color: var(--crimson);
  }

  .catalogue__frame {
    height: min(85svh, 900px);
    background: var(--bg);
  }

  .catalogue__frame:fullscreen {
    height: 100svh;
    border: 0;
    border-radius: 0;
  }

  /* Enquiry bar */

  .catalogue__enquiry {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: clamp(16px, 3vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .catalogue__label {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--ink-2);
  }

  .catalogue__input {
    flex: 1 1 220px;
    min-height: 48px;
    padding: 0 0.9rem;
    border: 1.5px solid var(--ink-3);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .catalogue__input:focus-visible {
    border-color: var(--crimson);
  }

  .catalogue__send {
    flex: none;
    min-height: 48px;
  }

  @media (max-width: 400px) {
    .catalogue__send {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cat]').forEach((root) => {
    const facade = root.querySelector<HTMLElement>('[data-cat-facade]');
    const panel = root.querySelector<HTMLElement>('[data-cat-panel]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-cat-open]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-cat-close]');
    const fullBtn = root.querySelector<HTMLButtonElement>('[data-cat-full]');
    const frameHost = root.querySelector<HTMLElement>('[data-cat-frame]');
    const form = root.querySelector<HTMLFormElement>('[data-cat-form]');
    const input = root.querySelector<HTMLInputElement>('[data-cat-form] input[name="product"]');
    if (!facade || !panel || !openBtn || !closeBtn || !fullBtn || !frameHost || !form || !input) return;

    const name = root.dataset.catName ?? 'catalogue';
    const viewerBase = root.dataset.catViewer ?? '';
    const pdfUrl = root.dataset.catPdf ?? '';
    const fallbackMessage = root.dataset.catFallback ?? '';
    const waBase = form.dataset.catWaBasis ?? '';

    const viewSrc = (page?: number): string => {
      const hash = page ? `#page=${page}&zoom=page-width` : '#zoom=page-width';
      return `${viewerBase}?file=${encodeURIComponent(pdfUrl)}${hash}`;
    };

    let iframe: HTMLIFrameElement | null = null;
    let currentPage: number | undefined;

    const close = (): void => {
      panel.hidden = true;
      facade.hidden = false;
      if (iframe) {
        iframe.remove();
        iframe = null;
      }
      delete document.body.dataset.catalogueOpen;
      openBtn.focus();
    };

    const open = (page?: number): void => {
      if (!iframe) {
        iframe = document.createElement('iframe');
        iframe.setAttribute('title', `${name} catalogue reader`);
        frameHost.replaceChildren(iframe);
      }
      currentPage = page;
      iframe.src = viewSrc(currentPage);
      facade.hidden = true;
      panel.hidden = false;
      document.body.dataset.catalogueOpen = 'true';
      closeBtn.focus();
    };

    openBtn.addEventListener('click', () => open(currentPage));
    closeBtn.addEventListener('click', close);

    const supportsFullscreen = 'requestFullscreen' in document.documentElement;
    if (supportsFullscreen) {
      const setFullName = (): void => {
        fullBtn.textContent = document.fullscreenElement ? 'Exit fullscreen' : 'Fullscreen';
      };
      fullBtn.addEventListener('click', () => {
        if (document.fullscreenElement) {
          void document.exitFullscreen().catch(() => undefined);
        } else {
          void panel.requestFullscreen().catch(() => undefined);
        }
      });
      document.addEventListener('fullscreenchange', setFullName);
    } else {
      fullBtn.hidden = true;
    }

    root.querySelectorAll<HTMLButtonElement>('[data-cat-page]').forEach((chip) => {
      chip.addEventListener('click', () => {
        open(Number.parseInt(chip.dataset.catPage ?? '1', 10));
      });
    });

    const send = root.querySelector<HTMLButtonElement>('[data-cat-send]');

    const submit = (event: Event): void => {
      event.preventDefault();
      const product = input.value.trim();
      const message = product
        ? `Hello JIE, I am interested in ${product}. Please provide specifications and pricing.`
        : fallbackMessage;
      const waUrl = `${waBase}?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank', 'noopener');
    };

    if (send) send.addEventListener('click', submit);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') submit(event);
    });
  });
</script>
