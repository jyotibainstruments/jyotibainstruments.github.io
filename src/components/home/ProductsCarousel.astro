---
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Card from '../Card.astro';
import Carousel from '../Carousel.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import Icon from '../icons/Icon.astro';
import { claims } from '../../config/site';
import {
  companyPath,
  displayableAuthorisationForBrand,
  home,
  visibleCompanies,
} from '../../lib/content';
import { url } from '../../lib/url';

const hasCompanies = visibleCompanies.length > 0;

/* Categories from the brochure's supply list, used while no catalogue is published. */
const supplies = [
  'Mechanical measuring instruments',
  'Pressure gauges',
  'Thermocouples and RTD sensors',
  'Temperature and PID controllers',
  'Electrical and lab instruments',
];
---

<Section labelledby="products-title">
  <SectionHeading
    id="products-title"
    title={home.products.title}
    intro={home.products.intro}
    link={{ label: 'All products', href: url('/products/') }}
  />

  {
    hasCompanies ? (
      <Carousel label="Product catalogues">
        {visibleCompanies.map((company) => {
          const authorisation = claims.showAuthorisedBrands
            ? displayableAuthorisationForBrand(company.slug)
            : undefined;
          return (
            <Card href={url(companyPath(company.slug))}>
              <div class="product-card">
                <div class="product-card__head">
                  <span class="product-card__name">{company.name}</span>
                  {authorisation && <span class="product-card__badge">Authorised</span>}
                </div>
                <span class="product-card__action">
                  View catalogue
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </Card>
          );
        })}
      </Carousel>
    ) : (
      <div class="supply">
        <div class="supply__copy">
          <span class="icon-circle" aria-hidden="true">
            <Icon name="clipboard" size={26} />
          </span>
          <h3>Ask for specifications and pricing</h3>
          <p>
            Instruments and spares are supplied from leading brands, with calibration and repair
            support for all major brands of measuring instruments. Tell us the instrument and we will
            reply with specifications and pricing.
          </p>
          <WhatsAppButton placement="home-products" label="Enquire on WhatsApp" />
        </div>

        <div class="supply__list">
          <h4>Instruments and spares supplied</h4>
          <ul>
            {
              supplies.map((supply) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false">
                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {supply}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    )
  }
</Section>

<style>
  .product-card {
    flex: 1;
    display: flex;
    min-height: 140px;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .product-card__name {
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
  }

  .product-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .product-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--crimson-50);
    color: var(--crimson-900);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .product-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--crimson);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .product-card__action svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .supply {
    display: grid;
    gap: var(--space-6);
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  @media (min-width: 880px) {
    .supply {
      grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
      gap: var(--space-9);
      align-items: center;
    }
  }

  .icon-circle {
    display: inline-grid;
    width: 52px;
    height: 52px;
    margin-bottom: var(--space-3);
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--crimson-50);
    color: var(--crimson);
  }

  .supply h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .supply p {
    max-width: 54ch;
    margin: 0 0 var(--space-5);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .supply__list {
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--bg);
  }

  .supply__list h4 {
    margin: 0 0 var(--space-3);
    color: var(--ink-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .supply__list ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .supply__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .supply__list svg {
    width: 17px;
    height: 17px;
    flex: none;
    margin-top: 0.15rem;
    color: var(--crimson);
  }
</style>
