---
import Button from '../Button.astro';
import Placeholder from '../Placeholder.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { home } from '../../lib/content';
import { url } from '../../lib/url';

const { hero } = home;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="hero__lead">{hero.summary}</p>

      <div class="hero__actions">
        <WhatsAppButton placement="home-hero" />
        <Button href={url('/products/')} variant="secondary">Explore products</Button>
      </div>

      <ul class="chips">
        {
          hero.chips.map((chip) => (
            <li class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false">
                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{chip}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__media">
      <Placeholder ratio="4 / 3" label="Lab photo to be supplied" />
    </div>
  </div>

  <div class="ruler" aria-hidden="true"></div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 76px) 0;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.75fr);
      gap: var(--space-10);
    }
  }

  .eyebrow {
    color: var(--crimson);
    font-weight: 700;
  }

  h1 {
    max-width: 16ch;
    margin-bottom: var(--space-5);
  }

  .hero__lead {
    max-width: 56ch;
    color: var(--ink-2);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-6);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .chip svg {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--crimson);
  }

  .hero__media {
    width: 100%;
    max-width: 560px;
  }

  @media (min-width: 900px) {
    .hero__media {
      max-width: none;
      justify-self: end;
    }
  }

  .hero .ruler {
    margin-top: clamp(36px, 5vw, 64px);
  }
</style>
