---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Button from '../Button.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { home } from '../../lib/content';
import { site } from '../../config/site';
import { asset, telHref, url } from '../../lib/url';

const { hero } = home;

const lab = site.offices.find((office) => office.kind === 'lab');
const branch = site.offices.find((office) => office.kind === 'branch');

/**
 * The hero falls back to the quick-contact card. When the owner supplies a
 * photo at public/images/hero.(avif|webp|jpg|jpeg|png) the hero uses it
 * automatically — no template change needed.
 */
const heroPhotoNames = ['hero.avif', 'hero.webp', 'hero.jpg', 'hero.jpeg', 'hero.png'];
const imagesDir = new URL('../../../public/images/', import.meta.url);
const heroPhoto = heroPhotoNames.find((name) => existsSync(fileURLToPath(new URL(name, imagesDir))) && fileURLToPath(new URL(name, imagesDir)));
const heroSrc = heroPhoto ? asset(`/images/${heroPhoto}`) : null;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>

      <ul class="chips">
        {
          hero.chips.map((chip) => (
            <li class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false">
                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{chip}</span>
            </li>
          ))
        }
      </ul>

      <p class="hero__lead">{hero.summary}</p>

      <div class="hero__actions">
        <Button href={url('/products/')} variant="secondary">Explore products</Button>
        <Button href={url('/services/')} variant="ghost">All services</Button>
      </div>
    </div>

    <div class="hero__media">
      {
        heroSrc ? (
          <img
            class="hero__photo"
            src={heroSrc}
            alt="JIE calibration laboratory"
            width="1200"
            height="900"
            loading="eager"
            decoding="async"
          />
        ) : (
          <aside class="quick-card" aria-labelledby="quick-contact-title">
            <h2 id="quick-contact-title" class="quick-card__title">Quick contact</h2>

            {lab && (
              <div class="quick-card__office">
                <p class="quick-card__kind">
                  <span class="quick-card__dot" aria-hidden="true"></span>
                  Calibration lab, Belgaum
                </p>
                <ul class="quick-card__phones">
                  {lab.phones.map((phone) => (
                    <li>
                      <a href={telHref(phone)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                          <path d="M5.2 4h3.6l1.8 4.5-2.2 1.4a12.5 12.5 0 0 0 5.3 5.3l1.4-2.2L20 14.8v3.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.2 6.2 2 2 0 0 1 5.2 4z" />
                        </svg>
                        {phone}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {branch && (
              <div class="quick-card__office">
                <p class="quick-card__kind">
                  <span class="quick-card__dot" aria-hidden="true"></span>
                  Branch office, Hubli
                </p>
                <ul class="quick-card__phones">
                  {branch.phones.map((phone) => (
                    <li>
                      <a href={telHref(phone)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                          <path d="M5.2 4h3.6l1.8 4.5-2.2 1.4a12.5 12.5 0 0 0 5.3 5.3l1.4-2.2L20 14.8v3.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.2 6.2 2 2 0 0 1 5.2 4z" />
                        </svg>
                        {phone}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <WhatsAppButton placement="home-hero-card" label="WhatsApp the team" block />
          </aside>
        )
      }
    </div>
  </div>

  <div class="ruler" aria-hidden="true"></div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 76px) 0;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.75fr);
      gap: var(--space-10);
    }
  }

  .eyebrow {
    color: var(--crimson);
    font-weight: 700;
  }

  h1 {
    max-width: 16ch;
    margin-bottom: var(--space-4);
  }

  .hero__lead {
    max-width: 56ch;
    color: var(--ink-2);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-6) 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .chip svg {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--crimson);
  }

  .hero__media {
    width: 100%;
    max-width: 560px;
  }

  @media (min-width: 900px) {
    .hero__media {
      max-width: none;
      justify-self: end;
    }
  }

  .hero__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .quick-card {
    display: grid;
    gap: var(--space-4);
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid var(--line);
    border-top: 4px solid var(--crimson);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  /* At tablet width the stacked card stretches; put the two offices side by side. */
  @media (min-width: 640px) and (max-width: 899px) {
    .quick-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .quick-card__title,
    .quick-card :global(.btn) {
      grid-column: 1 / -1;
    }

    .quick-card__title + .quick-card__office {
      padding-top: var(--space-3);
      border-top: 1px solid var(--line);
    }
  }

  .quick-card__title {
    margin: 0;
    color: var(--ink-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .quick-card__office {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .quick-card__title + .quick-card__office {
    padding-top: 0;
    border-top: 0;
  }

  .quick-card__kind {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: none;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .quick-card__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--gold);
  }

  .quick-card__phones {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick-card__phones li {
    margin: 0;
  }

  .quick-card__phones a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .quick-card__phones a:hover {
    color: var(--crimson);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .quick-card__phones svg {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--crimson);
  }

  .hero .ruler {
    margin-top: clamp(36px, 5vw, 64px);
  }
</style>
