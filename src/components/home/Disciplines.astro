---
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Card from '../Card.astro';
import Button from '../Button.astro';
import Icon from '../icons/Icon.astro';
import type { IconName } from '../icons/types';
import { calibrationDisciplines, home } from '../../lib/content';
import { url } from '../../lib/url';

const icons: Record<string, IconName> = {
  'mechanical-pressure': 'gauge',
  'electro-technical': 'bolt',
  thermal: 'thermometer',
  'fluid-flow': 'flow',
  medical: 'flask',
  civil: 'building',
};

const onSite = home.onSite;
---

<Section tone="surface" labelledby="disciplines-title">
  <SectionHeading id="disciplines-title" title={home.disciplines.title} intro={home.disciplines.intro} />

  <ul class="grid">
    {
      <>
        {calibrationDisciplines.map((discipline) => (
          <li>
            <Card href={url(discipline.path)}>
              <div class="tile">
                <span class="icon-circle" aria-hidden="true">
                  <Icon name={icons[discipline.slug] ?? 'gauge'} size={26} />
                </span>
                <h3>{discipline.navTitle}</h3>
                <p>{discipline.examples.slice(0, 4).join(' · ')}</p>
                <span class="more">
                  Calibration details
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </Card>
          </li>
        ))}

        <li class="onsite-item">
          <article class="onsite">
            <span class="onsite__icon" aria-hidden="true">
              <Icon name="truck" size={28} />
            </span>
            <div class="onsite__copy">
              <h3>{onSite.title}</h3>
              <p>{onSite.summary}</p>
            </div>
            <ul class="onsite__points">
              {onSite.points.map((point) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false">
                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
            <Button href={url('/services/on-site-calibration/')} variant="ghost" size="sm">
              On-site calibration details
            </Button>
          </article>
        </li>
      </>
    }
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
    margin: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .icon-circle {
    display: inline-grid;
    width: 52px;
    height: 52px;
    margin-bottom: var(--space-3);
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--crimson-50);
    color: var(--crimson);
  }

  .tile h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .tile p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--crimson);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .more svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  /* On-site calibration is the highlighted card in the discipline grid. */
  .onsite-item {
    grid-column: 1 / -1;
  }

  .onsite {
    display: grid;
    align-items: center;
    gap: var(--space-5);
    width: 100%;
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid var(--line);
    border-left: 4px solid var(--crimson);
    border-radius: var(--radius-card);
    background: var(--crimson-50);
    color: var(--ink);
  }

  @media (min-width: 860px) {
    .onsite {
      grid-template-columns: auto minmax(0, 1.5fr) minmax(180px, 0.8fr) auto;
      gap: var(--space-6);
    }
  }

  .onsite__icon {
    display: inline-grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--crimson);
  }

  .onsite h3 {
    margin: 0 0 var(--space-2);
    color: var(--crimson-900);
    font-size: var(--text-lg);
  }

  .onsite p {
    max-width: 54ch;
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .onsite__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .onsite__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .onsite__points svg {
    width: 17px;
    height: 17px;
    flex: none;
    color: var(--crimson);
  }

  .onsite :global(.btn--ghost) {
    border-color: var(--crimson);
    color: var(--crimson);
    white-space: nowrap;
  }

  .onsite :global(.btn--ghost:hover) {
    border-color: var(--crimson-900);
    background: var(--surface);
    color: var(--crimson-900);
  }
</style>
