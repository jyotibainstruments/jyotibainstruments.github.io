---
import Section from '../Section.astro';
import Button from '../Button.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { site, primaryPhone } from '../../config/site';
import { home } from '../../lib/content';
import { telHref } from '../../lib/url';

const phones = [...new Set(site.offices.flatMap((office) => office.phones))];
---

<Section tone="surface" labelledby="cta-title">
  <div class="panel">
    <div class="panel__inner">
      <div>
        <h2 id="cta-title">{home.cta.title}</h2>
        <p>{home.cta.summary}</p>
      </div>

      <div class="actions">
        <WhatsAppButton placement="home-cta" />
        {
          primaryPhone && (
            <Button href={telHref(primaryPhone)} variant="ghost">
              Call {primaryPhone}
            </Button>
          )
        }
      </div>
    </div>

    {
      phones.length > 0 && (
        <ul class="phones">
          {phones.map((phone) => (
            <li>
              <a href={telHref(phone)}>{phone}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Section>

<style>
  .panel {
    --focus-keyline: var(--on-crimson);

    padding: clamp(28px, 5vw, 56px);
    border-radius: 24px;
    background: var(--crimson);
    color: var(--on-crimson);
  }

  .panel__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 880px) {
    .panel__inner {
      grid-template-columns: minmax(0, 1.2fr) auto;
      gap: var(--space-8);
    }
  }

  .panel h2 {
    margin: 0 0 var(--space-3);
    color: var(--on-crimson);
  }

  .panel p {
    max-width: 52ch;
    margin: 0;
    color: color-mix(in srgb, var(--on-crimson) 84%, transparent);
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .panel :global(.btn--ghost) {
    border-color: color-mix(in srgb, var(--on-crimson) 65%, transparent);
    color: var(--on-crimson);
  }

  .panel :global(.btn--ghost:hover) {
    border-color: var(--on-crimson);
    background: var(--surface);
    color: var(--crimson);
  }

  .phones {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--on-crimson) 18%, transparent);
    list-style: none;
  }

  .phones li {
    margin: 0;
  }

  .phones a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--gold-on-crimson);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .phones a:hover {
    color: var(--on-crimson);
    text-decoration: underline;
  }
</style>
