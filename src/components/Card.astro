---
interface Props {
  href?: string;
  as?: 'div' | 'article' | 'li';
  padded?: boolean;
  class?: string;
}

const { href, as = 'div', padded = true, class: className } = Astro.props;
const Tag = href ? 'a' : as;
---

<Tag href={href} class:list={['card', padded && 'card--padded', href && 'card--link', className]}>
  <slot />
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
  }

  .card--padded {
    padding: var(--space-5);
  }

  .card--link {
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .card--link:hover {
    border-color: rgb(116 9 43 / 35%);
    box-shadow: var(--shadow-card);
    color: var(--ink);
  }

  .card--link:active {
    transform: translateY(1px);
  }
</style>
