---
import Breadcrumbs from './Breadcrumbs.astro';

interface Item {
  name: string;
  path: string;
}

interface Props {
  heading: string;
  intro: string[];
  items: Item[];
  class?: string;
}

const { heading, intro, items, class: className } = Astro.props;
---

<header class:list={['page-head', className]}>
  <div class="container">
    <Breadcrumbs items={items} />

    <div class="page-head__grid">
      <h1>{heading}</h1>
      <div class="page-head__intro">
        {
          intro.map((paragraph, index) => (
            <p class:list={[index === 0 && 'page-head__lead']}>{paragraph}</p>
          ))
        }
      </div>
    </div>

    <div class="page-head__actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .page-head {
    padding-block: var(--space-3) clamp(40px, 6vw, 72px);
  }

  .page-head__grid {
    display: grid;
    gap: var(--space-4) var(--space-9);
    margin-top: var(--space-5);
  }

  @media (min-width: 960px) {
    .page-head__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
      margin-top: var(--space-6);
    }
  }

  h1 {
    max-width: 18ch;
    margin: 0;
  }

  .page-head__intro {
    display: grid;
    gap: var(--space-3);
    max-width: 62ch;
  }

  .page-head__intro p {
    margin: 0;
    color: var(--ink-2);
  }

  .page-head__intro .page-head__lead {
    color: var(--ink);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .page-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .page-head__actions:empty {
    display: none;
  }
</style>
