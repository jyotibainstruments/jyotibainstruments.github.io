---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { site, primaryPhone } from '../config/site';
import { contactPage, offices, locationCities } from '../lib/content';
import { breadcrumbJsonLd, localBusinessJsonLd } from '../lib/seo';
import { mailtoHref, mapSearchHref, telHref, url } from '../lib/url';

const content = contactPage;

const items = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];

const realOffices = offices.filter((office) => office.addressParts);
const statedOffices = offices.filter((office) => !office.addressParts);

const serviceAreaCities = new Set<string>(locationCities.filter((city) => city.serviceArea).map((city) => city.slug));

const officeHref = (slug: string) => (serviceAreaCities.has(slug) ? url('/locations/dharwad/') : url(`/locations/${slug}/`));
const cityName = (slug: string) => slug.charAt(0).toUpperCase() + slug.slice(1);
---

<SiteLayout
  title={content.metaTitle}
  description={content.metaDescription}
  path="/contact/"
  jsonLd={[
    ...realOffices.map((office) => localBusinessJsonLd(office)),
    breadcrumbJsonLd(items),
  ]}
>
  <PageHeader heading={content.heading} intro={content.intro} items={items}>
    <Fragment slot="actions">
      <WhatsAppButton
        placement="contact"
        message={content.serviceMessage}
        label={content.whatsappTitle}
      />
      {
        primaryPhone && (
          <Button href={telHref(primaryPhone)} variant="ghost">
            Call {primaryPhone}
          </Button>
        )
      }
    </Fragment>
  </PageHeader>

  <Section tone="surface" labelledby="contact-offices">
    <SectionHeading id="contact-offices" title={content.officesTitle} intro={content.officesIntro} />

    <ul class="grid">
      {
        realOffices.map((office) => (
          <li>
            <Card>
              <div class="office">
                <p class="office__kind">
                  {office.kind === 'lab' ? 'Calibration lab (main branch)' : 'Branch office'}
                </p>
                <h3>{cityName(office.slug)}</h3>
                <address>{office.address}</address>

                {office.phones.length > 0 && (
                  <ul class="phones">
                    {office.phones.map((phone) => (
                      <li>
                        <a href={telHref(phone)}>
                          {phone}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {office.mapQuery && (
                  <a class="map" href={mapSearchHref(office.mapQuery)} target="_blank" rel="noopener">
                    {content.mapsText}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                      <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                )}

                <p class="office__more">
                  <a href={officeHref(office.slug)}>More about {cityName(office.slug)}</a>
                </p>
              </div>
            </Card>
          </li>
        ))
      }

      {
        statedOffices.map((office) => (
          <li>
            <Card>
              <div class="office">
                <p class="office__kind">{content.statedOnlyLabel}</p>
                <h3>{office.name}</h3>
                <address>{office.address}</address>
                <p class="office__unlisted">{content.statedOnlyNote}</p>
              </div>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="bg" labelledby="contact-direct">
    <div class="direct">
      <div class="direct__col">
        <h2 id="contact-direct">{content.emailsTitle}</h2>
        <ul class="direct__list">
          {site.emails.map((email) => (
            <li>
              <a href={mailtoHref(email)}>{email}</a>
            </li>
          ))}
        </ul>

        <h2>{content.gstinTitle}</h2>
        <p class="direct__gstin">{site.gstin}</p>
        <p class="direct__note">{content.gstinNote}</p>
      </div>

      <div class="direct__col direct__col--panel">
        <h2>{content.whatsappTitle}</h2>
        <p>{content.whatsappText}</p>
        <WhatsAppButton
          placement="contact-panel"
          message={content.serviceMessage}
          label={content.whatsappTitle}
          block
        />
      </div>
    </div>

    <p class="locations-link">
      <a href={url('/locations/')}>{content.locationsLink}</a> — the cities and service areas page describes the Belgaum laboratory, the Hubli branch, the Dharwad service area and the offices stated in Pune and Ahmedabad.
    </p>
  </Section>

  <CtaPanel
    title={content.closingTitle}
    text={content.closingText}
    placement="contact-cta"
    message={content.serviceMessage}
  />
</SiteLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
    margin: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .office {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .office__kind {
    margin: 0;
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .office h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .office address {
    font-style: normal;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .office__unlisted {
    margin: 0;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  .phones {
    display: grid;
    gap: 0.15rem;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .phones a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .office .map {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    margin-top: var(--space-2);
    margin-bottom: -6px;
    color: var(--crimson);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .office .map svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .office__more {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
  }

  .office__more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -8px;
    color: var(--ink-2);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .direct {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 760px) {
    .direct {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .direct__col h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .direct__col h2 + .direct__list {
    margin-bottom: var(--space-6);
  }

  .direct__col + .direct__col {
    margin-top: 0;
  }

  .direct__list {
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .direct__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .direct__gstin {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .direct__note {
    margin: var(--space-2) 0 0;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  .direct__col--panel {
    align-self: start;
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid rgb(116 9 43 / 16%);
    border-left: 4px solid var(--gold);
    border-radius: var(--radius-card);
    background: var(--crimson-50);
  }

  .direct__col--panel p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .locations-link {
    max-width: 62ch;
    margin: var(--space-6) 0 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .locations-link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--crimson);
    font-weight: 650;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* Print: reveal the maps URL (useless as an untappable link on paper) and drop nav-only rows. */
  @media print {
    .office__more,
    .locations-link {
      display: none !important;
    }

    .office .map::after {
      content: ' (' attr(href) ')';
      max-width: 100%;
      font-size: 0.75rem;
      font-weight: 400;
      word-break: break-all;
    }

    .office .map svg,
    .office .map .sr-only {
      display: none;
    }
  }
</style>
