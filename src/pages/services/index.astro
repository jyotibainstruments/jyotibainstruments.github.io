---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import Faq from '../../components/Faq.astro';
import Button from '../../components/Button.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { primaryPhone } from '../../config/site';
import {
  calibrationDisciplines,
  calibrationOverview,
  otherServices,
  servicesPage,
} from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';
import { telHref, url } from '../../lib/url';

const items = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];

const mainServices = [...(calibrationOverview ? [calibrationOverview] : []), ...otherServices];
---

<SiteLayout
  title={servicesPage.metaTitle}
  description={servicesPage.metaDescription}
  path="/services/"
  jsonLd={[breadcrumbJsonLd(items)]}
>
  <PageHeader heading={servicesPage.heading} intro={servicesPage.intro} items={items}>
    <Fragment slot="actions">
      <WhatsAppButton placement="services-hub" label="Enquire on WhatsApp" />
      {
        primaryPhone && (
          <Button href={telHref(primaryPhone)} variant="ghost">
            Call {primaryPhone}
          </Button>
        )
      }
    </Fragment>
  </PageHeader>

  <Section tone="surface" labelledby="services-main">
    <SectionHeading
      id="services-main"
      title="Services"
      intro="Calibration, on-site calibration, repairs and tool-error adjustment, and supply of spare parts and instruments."
    />

    <ul class="grid">
      {
        mainServices.map((service) => (
          <li>
            <Card href={url(service.path)}>
              <div class="tile">
                <h3>{service.navTitle}</h3>
                <p>{service.summary}</p>
                <span class="more">
                  View service
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="services-disciplines">
    <SectionHeading
      id="services-disciplines"
      title="Calibration disciplines"
      intro="Mechanical and pressure, electro-technical, thermal and temperature, fluid and flow, medical and bio-medical, and civil and material testing."
      link={{ label: 'Calibration overview', href: url('/services/calibration/') }}
    />

    <ul class="grid grid--three">
      {
        calibrationDisciplines.map((discipline) => (
          <li>
            <Card href={url(discipline.path)}>
              <div class="tile">
                <h3>{discipline.navTitle}</h3>
                <p>{discipline.examples.slice(0, 4).join(' · ')}</p>
                <span class="more">
                  Instruments
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="surface" labelledby="services-process">
    <SectionHeading
      id="services-process"
      title="How it works"
      intro="Four steps from receipt to return, with documentation intended for industry, regulatory and audit requirements."
    />
    <ProcessSteps />
  </Section>

  <Section labelledby="services-faq">
    <SectionHeading id="services-faq" title="Frequently asked questions" />
    <Faq items={servicesPage.faq} />
  </Section>

  <CtaPanel
    title="Talk to JIE about your instruments"
    text="Tell us what needs calibration, repair or replacement. We look forward to hearing from you."
    placement="services-hub-cta"
  />
</SiteLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
    margin: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .grid--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tile h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .tile p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--crimson);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .more svg {
    width: 14px;
    height: 14px;
    flex: none;
  }
</style>
