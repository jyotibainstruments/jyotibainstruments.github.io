---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import ProductsCarousel from '../components/home/ProductsCarousel.astro';
import Disciplines from '../components/home/Disciplines.astro';
import ProcessAndWhy from '../components/home/ProcessAndWhy.astro';
import ClientsMarquee from '../components/home/ClientsMarquee.astro';
import Locations from '../components/home/Locations.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { primaryOffice, site } from '../config/site';
import {
  buildTitle,
  localBusinessJsonLd,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';

const title = buildTitle('Calibration, repairs and sales');
const description =
  'Calibration, repairs and sales of industrial measuring instruments from a lab in Belgaum and a branch in Hubli. Enquire on WhatsApp.';

const branchOffice = site.offices.find((office) => office.kind === 'branch');

const jsonLd = [
  organizationJsonLd(),
  webSiteJsonLd(),
  localBusinessJsonLd(primaryOffice),
  ...(branchOffice ? [localBusinessJsonLd(branchOffice)] : []),
];
---

<SiteLayout
  title={title}
  description={description}
  path="/"
  jsonLd={jsonLd}
>
  <Hero />
  <ServicesOverview />
  <ProductsCarousel />
  <Disciplines />
  <ProcessAndWhy />
  <ClientsMarquee />
  <Locations />
  <FinalCta />
</SiteLayout>
