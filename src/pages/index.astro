---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import ProductsCarousel from '../components/home/ProductsCarousel.astro';
import Disciplines from '../components/home/Disciplines.astro';
import ProcessAndWhy from '../components/home/ProcessAndWhy.astro';
import ClientsMarquee from '../components/home/ClientsMarquee.astro';
import Locations from '../components/home/Locations.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { claims, primaryOffice, site } from '../config/site';
import {
  displayableNablCertificate,
  displayableNablScopeCertificate,
  getCertificate,
  isCertificateDisplayable,
} from '../lib/content';
import {
  buildTitle,
  localBusinessJsonLd,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';

const title = buildTitle('Calibration, repairs and sales');
const description =
  'Calibration, repairs and sales of industrial measuring instruments from a lab in Belgaum and a branch in Hubli. Enquire on WhatsApp.';

const branchOffice = site.offices.find((office) => office.kind === 'branch');

const nablCert = claims.showNablClaim ? displayableNablCertificate() : undefined;
const nablScope = claims.showNablClaim ? displayableNablScopeCertificate() : undefined;
const hasCertification =
  nablCert && nablScope
    ? {
        '@type': 'Certification',
        name: 'ISO/IEC 17025:2017 accreditation (certificate CC-3243)',
        issuedBy: {
          '@type': 'Organization',
          name: 'National Accreditation Board for Testing and Calibration Laboratories (NABL)',
        },
        certificationIdentification: 'CC-3243',
        validFrom: '2025-05-11',
        expires: '2029-05-10',
      }
    : undefined;

const bestDealer = claims.showAwards ? getCertificate('mahr-best-debutant-dealer') : undefined;
const awards =
  bestDealer && isCertificateDisplayable(bestDealer)
    ? ['Best Debutant Dealer 2025 (Mahr Metrology India Pvt. Ltd.)']
    : [];

const jsonLd = [
  organizationJsonLd({ hasCertification, awards }),
  webSiteJsonLd(),
  localBusinessJsonLd(primaryOffice),
  ...(branchOffice ? [localBusinessJsonLd(branchOffice)] : []),
];
---

<SiteLayout
  title={title}
  description={description}
  path="/"
  jsonLd={jsonLd}
>
  <Hero />
  <ServicesOverview />
  <ProductsCarousel />
  <Disciplines />
  <ProcessAndWhy />
  <ClientsMarquee />
  <Locations />
  <FinalCta />
</SiteLayout>
