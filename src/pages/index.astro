---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { buildTitle, organizationJsonLd, webSiteJsonLd } from '../lib/seo';
import logo from '../assets/brand/jie-logo.svg?url';

const title = buildTitle('Calibration, repairs and sales');
const description =
  'Calibration, repair and sales of industrial measuring instruments, with a calibration lab in Belgaum, Karnataka.';
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLd={[organizationJsonLd(), webSiteJsonLd()]}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Belgaum · Hubli · Dharwad · Pune · Ahmedabad</p>
        <h1>Calibration, repairs and sales of precision measuring instruments</h1>
        <p class="hero__lead">
          {site.name} provides industrial measuring instruments, calibration, sales and repair
          services from its calibration lab in Belgaum and branch office in Hubli.
        </p>
        <p class="hero__note">{site.tagline}</p>
      </div>
      <div class="hero__mark">
        <img src={logo} width="320" height="318" alt="Jyotiba Instruments Enterprises logo" />
      </div>
    </div>
    <div class="ruler" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(48px, 7vw, 88px) 0;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 860px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
      gap: var(--space-10);
    }
  }

  .eyebrow {
    margin-bottom: var(--space-3);
  }

  h1 {
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .hero__lead {
    max-width: 56ch;
    color: var(--ink-2);
    font-size: var(--text-lg);
  }

  .hero__note {
    margin-bottom: 0;
    color: var(--crimson);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .hero__mark {
    justify-self: start;
  }

  @media (min-width: 860px) {
    .hero__mark {
      justify-self: end;
    }
  }

  .hero__mark img {
    width: min(320px, 70vw);
    height: auto;
  }

  .hero .ruler {
    margin-top: clamp(40px, 6vw, 72px);
  }
</style>
