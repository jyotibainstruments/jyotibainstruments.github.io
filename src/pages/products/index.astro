---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { primaryPhone } from '../../config/site';
import { companyPath, productsPage, visibleCompanies } from '../../lib/content';
import { collectionPageJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { serviceEnquiry } from '../../lib/whatsapp';
import { telHref, url, asset } from '../../lib/url';

const items = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
];

const companies = visibleCompanies;
const emptyMessage = serviceEnquiry('your calibration and repair services');
---

<SiteLayout
  title={productsPage.metaTitle}
  description={productsPage.metaDescription}
  path="/products/"
  jsonLd={[
    collectionPageJsonLd({
      name: productsPage.heading,
      description: productsPage.metaDescription,
      path: '/products/',
    }),
    breadcrumbJsonLd(items),
  ]}
>
  <PageHeader heading={productsPage.heading} intro={productsPage.intro} items={items}>
    <Fragment slot="actions">
      {
        companies.length > 0 && (
          <WhatsAppButton
            placement="products-hub"
            message={serviceEnquiry('measuring instruments and gauges')}
            label="Enquire on WhatsApp"
          />
        )
      }
      {
        primaryPhone && (
          <Button href={telHref(primaryPhone)} variant="ghost">
            Call {primaryPhone}
          </Button>
        )
      }
    </Fragment>
  </PageHeader>

  {
    companies.length > 0 ? (
      <Section tone="surface" labelledby="products-grid">
        <SectionHeading
          id="products-grid"
          title="Catalogues"
          intro="Choose a brand to open its catalogue on this site, or ask about any instrument directly."
        />

        <ul class="grid">
          {companies.map((company) => (
            <li>
              <Card href={url(companyPath(company.slug))}>
                <div class="tile">
                  {company.logo ? (
                    <img
                      class="tile__logo"
                      src={asset(company.logo)}
                      alt={`${company.name} logo`}
                      width="320"
                      height="160"
                      loading="lazy"
                    />
                  ) : (
                    <span class="tile__wordmark">{company.name}</span>
                  )}
                  <span class="more">
                    View catalogue
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </Card>
            </li>
          ))}
        </ul>
      </Section>
    ) : (
      <Section labelledby="products-soon">
        <SectionHeading
          id="products-soon"
          title="Catalogues coming soon"
          intro="Brand catalogues are being prepared. Until they are published, ask about any instrument directly on WhatsApp."
        />

        <div class="soon">
          <p>
            Tell us the instrument, gauge or spare part you need. JIE supplies products from leading brands and
            provides calibration, repair and servicing for them too.
          </p>
          <WhatsAppButton placement="products-empty" message={emptyMessage} label="Ask about an instrument" />
        </div>
      </Section>
    )
  }

  <CtaPanel
    title="Ask about an instrument"
    text="Tell us the instrument, gauge or spare part you need. We look forward to hearing from you."
    placement="products-hub-cta"
  />
</SiteLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
    margin: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tile__logo {
    display: block;
    max-width: 200px;
    height: auto;
  }

  .tile__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--crimson-900);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: auto;
    color: var(--crimson);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .more svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .soon {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 62ch;
    padding: clamp(24px, 4vw, 40px);
    border: 1px dashed rgb(116 9 43 / 30%);
    border-radius: var(--radius-card);
    background: var(--crimson-50);
  }

  .soon p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
</style>
