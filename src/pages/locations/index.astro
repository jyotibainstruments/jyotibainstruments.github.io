---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { primaryPhone } from '../../config/site';
import { locationCities, locationsContent, offices } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';
import { mapSearchHref, telHref, url } from '../../lib/url';

const content = locationsContent;

const items = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations/' },
];

const realOffices = offices.filter((office) => office.addressParts);
const statedOffices = offices.filter((office) => !office.addressParts);
const cityDetailHeading = new Map<string, string>(locationCities.map((city) => [city.slug, city.heading]));
const serviceAreaCities = locationCities.filter((city) => city.serviceArea);

const detailsLabel = (slug: string) => content.detailsLabel.replace('{city}', slug.charAt(0).toUpperCase() + slug.slice(1));
---

<SiteLayout
  title={content.metaTitle}
  description={content.metaDescription}
  path="/locations/"
  jsonLd={[breadcrumbJsonLd(items)]}
>
  <PageHeader heading={content.heading} intro={content.intro} items={items}>
    <Fragment slot="actions">
      <WhatsAppButton placement="locations" label="Chat on WhatsApp" />
      {primaryPhone && <Button href={telHref(primaryPhone)} variant="ghost">Call {primaryPhone}</Button>}
    </Fragment>
  </PageHeader>

  <Section tone="surface" labelledby="locations-offices">
    <SectionHeading id="locations-offices" title="Offices with phones and directions" />

    <ul class="grid">
      {
        realOffices.map((office) => (
          <li>
            <Card href={url(`/locations/${office.slug}/`)}>
              <div class="place">
                <p class="place__kind">{content.realOfficeLabel}</p>
                <h3>{cityDetailHeading.get(office.slug) ?? office.shortName}</h3>
                <address>{office.address}</address>

                {office.phones.length > 0 && (
                  <ul class="phones">
                    {office.phones.map((phone) => (
                      <li>
                        <a href={telHref(phone)}>{phone}</a>
                      </li>
                    ))}
                  </ul>
                )}

                {office.mapQuery && (
                  <a class="map" href={mapSearchHref(office.mapQuery)} target="_blank" rel="noopener">
                    Open in Google Maps
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                      <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                )}

                <span class="more">
                  {detailsLabel(office.slug)}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="bg" labelledby="locations-area">
    <SectionHeading
      id="locations-area"
      title="Service area and other offices"
      link={{ label: 'Contact details', href: url('/contact/') }}
    />

    <ul class="grid">
      {
        serviceAreaCities.map((city) => (
          <li>
            <Card href={url(`/locations/${city.slug}/`)}>
              <div class="place">
                <p class="place__kind">{content.serviceAreaLabel}</p>
                <h3>{city.heading}</h3>
                <p>No JIE office is listed in {city.slug.charAt(0).toUpperCase() + city.slug.slice(1)}; the team covers it from the Belgaum lab and the Hubli branch.</p>
                <span class="more">
                  {detailsLabel(city.slug)}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </Card>
          </li>
        ))
      }

      {
        statedOffices.map((office) => (
          <li>
            <Card>
              <div class="place">
                <p class="place__kind">{content.statedOnlyLabel}</p>
                <h3>{office.name}</h3>
                <address>{office.address}</address>
                <p class="place__note">{content.statedOnlyNote}</p>
              </div>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaPanel
    title="Reach the nearest team"
    text="WhatsApp or a phone call reaches the same team wherever you are in the list above."
    placement="locations-cta"
  />
</SiteLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
    margin: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .place {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .place__kind {
    margin: 0;
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .place h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .place address {
    font-style: normal;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .place__note {
    margin: 0;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  .phones {
    display: grid;
    gap: 0.15rem;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .phones a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .place .map {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--crimson);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .place .map svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--crimson);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .more svg {
    width: 14px;
    height: 14px;
    flex: none;
  }
</style>
